<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View for Generated Specifications -->
    <record id="view_hr_employee_specification_list" model="ir.ui.view">
        <field name="name">hr.employee.specification.list</field>
        <field name="model">hr.employee.specification</field>
        <field name="arch" type="xml">
            <list string="Monthly Specifications" create="false" edit="false">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="spec_type"/>
                <field name="amount"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_specification_form" model="ir.ui.view">
        <field name="name">hr.employee.specification.form</field>
        <field name="model">hr.employee.specification</field>
        <field name="arch" type="xml">
            <form string="Monthly Specification" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="spec_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="config_id"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_specification" model="ir.actions.act_window">
        <field name="name">Monthly Specifications</field>
        <field name="res_model">hr.employee.specification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No monthly specifications generated yet.
            </p>
        </field>
    </record>

    <!-- Setup View for Global Specification Settings -->
    <record id="view_hr_employee_specification_setup_list" model="ir.ui.view">
        <field name="name">hr.employee.specification.setup.list</field>
        <field name="model">hr.employee.specification.setup</field>
        <field name="arch" type="xml">
            <list string="Specification Types" editable="bottom">
                <field name="spec_type"/>
                <field name="issue_day"/>
                <field name="journal_id"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_employee_specification_setup" model="ir.actions.act_window">
        <field name="name">Specification Types</field>
        <field name="res_model">hr.employee.specification.setup</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your global specification settings here (Journal, Accounts, Issue Day).
            </p>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_hr_employee_specification"
              name="Monthly Specifications"
              parent="hr.menu_hr_root"
              action="action_hr_employee_specification"
              sequence="95"/>

    <menuitem id="menu_hr_employee_specification_setup"
              name="Specification Types"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_employee_specification_setup"
              sequence="100"/>
</odoo>
