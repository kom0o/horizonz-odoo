<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hr_travel_ticket_tree" model="ir.ui.view">
        <field name="name">hr.travel.ticket.tree</field>
        <field name="model">hr.travel.ticket</field>
        <field name="arch" type="xml">
            <list string="Travel Tickets">
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="travel_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_travel_ticket_form" model="ir.ui.view">
        <field name="name">hr.travel.ticket.form</field>
        <field name="model">hr.travel.ticket</field>
        <field name="arch" type="xml">
            <form string="Travel Ticket Request">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" placeholder="Employee..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="last_back_date"/>
                            <field name="worked_days"/>
                            <field name="days_for_ticket"/>
                            <field name="contract_id"/>
                            <field name="country_id"/>
                            <field name="airport"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="travel_date"/>
                            <field name="payment_method"/>
                            <field name="actual_ticket_amount"/>
                            <field name="actual_visa_amount"/>
                            <field name="additional_cost_by_employee"/>
                            <field name="is_settlement"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Available Tickets">
                            <field name="ticket_line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="dependent"/>
                                    <field name="relationship"/>
                                    <field name="type"/>
                                    <field name="ticket_value" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_travel_ticket" model="ir.actions.act_window">
        <field name="name">Travel Ticket Request</field>
        <field name="res_model">hr.travel.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new travel ticket request
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_hr_travel_ticket_root"
              name="Travel Tickets"
              parent="hr.menu_hr_root"
              sequence="90"/>

    <menuitem id="menu_hr_travel_ticket"
              name="Travel Tickets"
              parent="menu_hr_travel_ticket_root"
              action="action_hr_travel_ticket"
              sequence="10"/>
</odoo>
