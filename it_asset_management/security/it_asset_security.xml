<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_assets" model="ir.module.category">
        <field name="name">IT Asset Management</field>
        <field name="description">Manage hardware assets, employee custody, and credentials</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_it_asset_user" model="res.groups">
        <field name="name">IT Custody Officer</field>
        <field name="category_id" ref="module_category_it_assets"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_it_asset_manager" model="res.groups">
        <field name="name">IT Manager / Administrator</field>
        <field name="category_id" ref="module_category_it_assets"/>
        <field name="implied_ids" eval="[(4, ref('group_it_asset_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
