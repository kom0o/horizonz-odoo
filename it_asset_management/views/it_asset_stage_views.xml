<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_stage_tree" model="ir.ui.view">
        <field name="name">it.asset.stage.list</field>
        <field name="model">it.asset.stage</field>
        <field name="arch" type="xml">
            <list string="Asset Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_type"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="view_it_asset_stage_form" model="ir.ui.view">
        <field name="name">it.asset.stage.form</field>
        <field name="model">it.asset.stage</field>
        <field name="arch" type="xml">
            <form string="Asset Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="stage_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description of the stage and its purpose..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_it_asset_stage" model="ir.actions.act_window">
        <field name="name">Asset Stages</field>
        <field name="res_model">it.asset.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create lifecycle stages for IT assets (e.g. Stock, Assigned, Scrap, Sold).
            </p>
        </field>
    </record>
</odoo>
