<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Credentials List View -->
    <record id="view_it_credential_tree" model="ir.ui.view">
        <field name="name">it.credential.list</field>
        <field name="model">it.credential</field>
        <field name="arch" type="xml">
            <list string="Credentials Vault">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="username"/>
                <field name="password" password="True"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Credentials Form View -->
    <record id="view_it_credential_form" model="ir.ui.view">
        <field name="name">it.credential.form</field>
        <field name="model">it.credential</field>
        <field name="arch" type="xml">
            <form string="IT Credential &amp; Access">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Hostinger Cloud VPS / Odoo Admin / Cisco Router"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Access Coordinates">
                            <field name="url" widget="url" placeholder="https://..."/>
                            <field name="username" placeholder="admin@domain.com"/>
                            <field name="password" password="True"/>
                        </group>
                        <group string="Configuration">
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Documentation &amp; Access Notes">
                        <field name="notes" placeholder="Port numbers, SSH keys, MFA guidelines, recovery codes..." nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_it_credential_search" model="ir.ui.view">
        <field name="name">it.credential.search</field>
        <field name="model">it.credential</field>
        <field name="arch" type="xml">
            <search string="Search Credentials">
                <field name="name"/>
                <field name="url"/>
                <field name="username"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_it_credential" model="ir.actions.act_window">
        <field name="name">Credentials Vault</field>
        <field name="res_model">it.credential</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_it_credential_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Store and document internal IT server logins, license keys, and administrative credentials securely.
            </p>
        </field>
    </record>
</odoo>
