<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- IT Asset Kanban View -->
    <record id="view_it_asset_kanban" model="ir.ui.view">
        <field name="name">it.asset.kanban</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="ref"/>
                <field name="asset_type"/>
                <field name="serial_no"/>
                <field name="model_sku"/>
                <field name="assigned_to_id"/>
                <field name="stage_id"/>
                <field name="stage_type"/>
                <field name="color"/>
                <field name="priority"/>
                <field name="kanban_state"/>
                <field name="image_1920"/>
                <progressbar field="kanban_state" colors='{"done": "success", "blocked": "danger", "normal": "muted"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click p-2">
                            <div class="o_kanban_image me-2 float-start">
                                <t t-if="record.image_1920.raw_value">
                                    <img t-att-src="kanban_image('it.asset', 'image_1920', record.id.raw_value)" alt="Device" class="o_image_64_contain rounded"/>
                                </t>
                                <t t-else="">
                                    <span class="fa fa-laptop fa-3x text-secondary d-flex align-items-center justify-content-center p-2"/>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-1">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title text-primary">
                                            <field name="ref"/>: <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="boolean_favorite" nolabel="1"/>
                                </div>
                                <div class="text-muted small">
                                    <span t-if="record.model_sku.value"><i class="fa fa-tag me-1" title="Model / SKU"/> <field name="model_sku"/><br/></span>
                                    <span t-if="record.serial_no.value"><i class="fa fa-barcode me-1" title="Serial Number"/> <field name="serial_no"/><br/></span>
                                    <span t-if="record.asset_location_id.value"><i class="fa fa-map-marker me-1" title="Location"/> <field name="asset_location_id"/><br/></span>
                                </div>
                                <div class="o_kanban_record_bottom mt-2 pt-1 border-top">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-if="record.assigned_to_id.value" class="badge text-bg-info">
                                            <i class="fa fa-user me-1" title="Assigned User"/> <field name="assigned_to_id"/>
                                        </span>
                                        <span t-else="" class="badge text-bg-success">
                                            In Stock
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="kanban_state" widget="state_selection"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- IT Asset List / Tree View -->
    <record id="view_it_asset_tree" model="ir.ui.view">
        <field name="name">it.asset.list</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <list string="IT Assets"
                  decoration-success="stage_type == 'stock'"
                  decoration-info="stage_type == 'assigned'"
                  decoration-danger="stage_type == 'scrap'"
                  decoration-muted="stage_type == 'sold'">
                <field name="ref"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="model_sku"/>
                <field name="serial_no"/>
                <field name="cpu" optional="show"/>
                <field name="ram" optional="show"/>
                <field name="asset_location_id" optional="show"/>
                <field name="assigned_to_id"/>
                <field name="assign_date" optional="hide"/>
                <field name="acquisition_price" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="stage_id" widget="badge"/>
                <field name="stage_type" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- IT Asset Form View -->
    <record id="view_it_asset_form" model="ir.ui.view">
        <field name="name">it.asset.form</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <form string="IT Asset">
                <header>
                    <button name="action_assign_wizard" string="Assign Custody" type="object"
                            class="btn-primary" invisible="stage_type != 'stock'"/>
                    <button name="action_set_to_stock" string="Restore to Stock" type="object"
                            class="btn-secondary" invisible="stage_type == 'stock'"
                            confirm="Are you sure you want to release this asset and restore it to available stock?"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="stage_type" invisible="1"/>
                    <widget name="web_ribbon" title="Scrapped" bg_color="text-bg-danger" invisible="stage_type != 'scrap'"/>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-secondary" invisible="stage_type != 'sold'"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>

                    <div class="oe_title">
                        <span class="o_form_label text-muted">Asset Reference</span>
                        <h1>
                            <field name="ref" class="text-primary"/>
                        </h1>
                        <label for="name" class="oe_edit_only"/>
                        <h2>
                            <field name="name" placeholder="e.g. HP ProBook 450 G10"/>
                        </h2>
                    </div>

                    <group>
                        <group name="asset_info" string="Device Information">
                            <field name="asset_type"/>
                            <field name="model_sku" placeholder="Model name and SKU number"/>
                            <field name="serial_no" placeholder="Hardware Serial Number"/>
                            <field name="condition"/>
                            <field name="priority" widget="boolean_favorite"/>
                        </group>
                        <group name="custody_info" string="Location &amp; Custody">
                            <field name="asset_location_id"/>
                            <field name="assigned_to_id"/>
                            <field name="assign_date" invisible="not assigned_to_id"/>
                            <field name="current_assignment_id" invisible="not current_assignment_id"/>
                            <field name="link" widget="url" placeholder="https://..."/>
                        </group>
                    </group>

                    <notebook>
                        <page name="hardware_specs" string="Hardware Specifications">
                            <group>
                                <group string="Processing &amp; Memory">
                                    <field name="cpu" placeholder="e.g. Intel Core i7 13th Generation"/>
                                    <field name="ram" placeholder="e.g. 16 GB DDR4"/>
                                </group>
                                <group string="Internal Storage">
                                    <field name="nvme" placeholder="e.g. 512 GB NVMe M.2"/>
                                    <field name="ssd" placeholder="e.g. 256 GB SSD"/>
                                    <field name="hdd" placeholder="e.g. 1 TB HDD"/>
                                </group>
                            </group>
                            <group string="Included Accessories">
                                <group>
                                    <field name="keyboard_included" widget="boolean_toggle"/>
                                    <field name="mouse_included" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>

                        <page name="software_compliance" string="Software &amp; OS">
                            <group>
                                <group string="System &amp; Productivity">
                                    <field name="os" placeholder="e.g. Windows 11 Pro 64-bit"/>
                                    <field name="ms_office" placeholder="e.g. Office 365 Business"/>
                                </group>
                                <group string="Security &amp; Other">
                                    <field name="anti_virus" placeholder="e.g. Kaspersky Endpoint / Defender"/>
                                    <field name="software_others" placeholder="Additional software licenses"/>
                                </group>
                            </group>
                        </page>

                        <page name="financial_info" string="Procurement &amp; Warranty">
                            <group>
                                <group string="Purchase Details">
                                    <field name="acquisition_date"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="acquisition_price" widget="monetary"/>
                                </group>
                                <group string="Support &amp; Warranty">
                                    <field name="warranty_status" placeholder="e.g. Active until 2027-12-31"/>
                                </group>
                            </group>
                        </page>

                        <page name="custody_history" string="Custody &amp; Return History">
                            <group>
                                <group string="Last Return Details">
                                    <field name="returned" readonly="1"/>
                                    <field name="return_date" readonly="1"/>
                                    <field name="return_reason" readonly="1"/>
                                    <field name="returned_from_id" readonly="1"/>
                                </group>
                                <group string="Previous Custodian">
                                    <field name="previous_owner" readonly="1"/>
                                    <field name="previous_issue_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page name="disposal_tab" string="Decommission &amp; Disposal" invisible="stage_type not in ['scrap', 'sold']">
                            <group>
                                <group string="Disposal Record">
                                    <field name="disposal_date"/>
                                    <field name="disposal_price" widget="monetary"/>
                                    <field name="sold_to_id"/>
                                </group>
                                <group string="Reason &amp; Documentation">
                                    <field name="disposal_notes"/>
                                </group>
                            </group>
                        </page>

                        <page name="internal_notes" string="Internal Notes">
                            <field name="notes" placeholder="Detailed equipment notes, damage history, repairs, etc..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- IT Asset Search View -->
    <record id="view_it_asset_search" model="ir.ui.view">
        <field name="name">it.asset.search</field>
        <field name="model">it.asset</field>
        <field name="arch" type="xml">
            <search string="Search IT Assets">
                <field name="name" string="Asset" filter_domain="['|', '|', ('name', 'ilike', self), ('ref', 'ilike', self), ('serial_no', 'ilike', self)]"/>
                <field name="ref"/>
                <field name="serial_no"/>
                <field name="model_sku"/>
                <field name="assigned_to_id"/>
                <field name="asset_location_id"/>

                <filter string="In Stock (Available)" name="filter_stock" domain="[('stage_type', '=', 'stock')]"/>
                <filter string="Assigned" name="filter_assigned" domain="[('stage_type', '=', 'assigned')]"/>
                <filter string="Scrapped" name="filter_scrap" domain="[('stage_type', '=', 'scrap')]"/>
                <filter string="Sold" name="filter_sold" domain="[('stage_type', '=', 'sold')]"/>
                <separator/>
                <filter string="Laptops" name="type_laptop" domain="[('asset_type', '=', 'laptop')]"/>
                <filter string="PCs &amp; Desktops" name="type_pc" domain="[('asset_type', '=', 'pc')]"/>
                <filter string="Monitors" name="type_screen" domain="[('asset_type', '=', 'screen')]"/>
                <filter string="Printers" name="type_printer" domain="[('asset_type', '=', 'printer')]"/>
                <separator/>
                <filter string="High Priority" name="filter_priority" domain="[('priority', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Asset Type" name="group_type" context="{'group_by': 'asset_type'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'asset_location_id'}"/>
                    <filter string="Custodian" name="group_assigned_to" context="{'group_by': 'assigned_to_id'}"/>
                    <filter string="Physical Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for IT Assets -->
    <record id="action_it_asset" model="ir.actions.act_window">
        <field name="name">IT Assets Inventory</field>
        <field name="res_model">it.asset</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_it_asset_search"/>
        <field name="context">{'search_default_filter_stock': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new hardware asset, laptop, PC, screen, or printer into the inventory.
            </p>
        </field>
    </record>
</odoo>
