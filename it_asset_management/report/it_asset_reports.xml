<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper Format -->
    <record id="paperformat_it_asset_custody" model="report.paperformat">
        <field name="name">IT Asset Custody Paperformat</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- Custody Issue Form Action -->
    <record id="action_report_it_asset_issue" model="ir.actions.report">
        <field name="name">IT Asset Issue Form (نموذج تسليم عهدة)</field>
        <field name="model">it.asset.assign</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_asset_management.report_it_asset_issue_template</field>
        <field name="report_file">it_asset_management.report_it_asset_issue_template</field>
        <field name="print_report_name">'IT_Asset_Issue_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_it_asset_assign"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_it_asset_custody"/>
    </record>

    <!-- Custody Return Form Action -->
    <record id="action_report_it_asset_return" model="ir.actions.report">
        <field name="name">IT Asset Return Form (نموذج استرجاع عهدة)</field>
        <field name="model">it.asset.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_asset_management.report_it_asset_return_template</field>
        <field name="report_file">it_asset_management.report_it_asset_return_template</field>
        <field name="print_report_name">'IT_Asset_Return_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_it_asset_return"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_it_asset_custody"/>
    </record>
</odoo>
