<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stage_stock" model="it.asset.stage">
        <field name="name">Stock (Available)</field>
        <field name="sequence">10</field>
        <field name="stage_type">stock</field>
        <field name="fold">False</field>
        <field name="description">Asset is in IT inventory, ready to be assigned.</field>
    </record>

    <record id="stage_assigned" model="it.asset.stage">
        <field name="name">Assigned</field>
        <field name="sequence">20</field>
        <field name="stage_type">assigned</field>
        <field name="fold">False</field>
        <field name="description">Asset is actively held by an employee under custody.</field>
    </record>

    <record id="stage_scrap" model="it.asset.stage">
        <field name="name">Scrap</field>
        <field name="sequence">30</field>
        <field name="stage_type">scrap</field>
        <field name="fold">True</field>
        <field name="description">Asset is damaged, lost, stolen, or written off at 0 SAR.</field>
    </record>

    <record id="stage_sold" model="it.asset.stage">
        <field name="name">Sold</field>
        <field name="sequence">40</field>
        <field name="stage_type">sold</field>
        <field name="fold">True</field>
        <field name="description">Asset was liquidated or sold to an external buyer/employee.</field>
    </record>
</odoo>
