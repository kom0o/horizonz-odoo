<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for IT Assets (e.g. A0001, A0057, A0147) -->
    <record id="seq_it_asset" model="ir.sequence">
        <field name="name">IT Asset Reference Code</field>
        <field name="code">it.asset.code</field>
        <field name="prefix">A</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Custody Assignments (e.g. ASG-0001) -->
    <record id="seq_it_asset_assign" model="ir.sequence">
        <field name="name">IT Asset Assignment Reference</field>
        <field name="code">it.asset.assign.code</field>
        <field name="prefix">ASG-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Returns (e.g. RET-0001) -->
    <record id="seq_it_asset_return" model="ir.sequence">
        <field name="name">IT Asset Return Reference</field>
        <field name="code">it.asset.return.code</field>
        <field name="prefix">RET-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Sequence for Disposals (e.g. DISP-0001) -->
    <record id="seq_it_asset_disposal" model="ir.sequence">
        <field name="name">IT Asset Disposal Reference</field>
        <field name="code">it.asset.disposal.code</field>
        <field name="prefix">DISP-</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
