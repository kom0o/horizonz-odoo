<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.whatsapp</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='user_default_rights']" position="after">
                    <block title="Odoo WhatsApp Integration" name="whatsapp_direct_message">
                        <setting id="whatsapp_direct_button" string="Direct WhatsApp Message" help="Click to enable direct whatsapp message feature">
                            <field name="group_send_sms"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
