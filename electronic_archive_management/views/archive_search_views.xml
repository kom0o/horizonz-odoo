<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_archive_document_search_form" model="ir.ui.view">
        <field name="name">archive.document.search.form</field>
        <field name="model">archive.document.search</field>
        <field name="arch" type="xml">
            <form string="آلية البحث والاسترجاع في الأرشيف الإلكتروني" class="o_archive_search_view">
                <header>
                    <button name="action_search" string="تنفيذ البحث والاسترجاع" type="object" class="btn-primary" icon="fa-search"/>
                    <button name="action_reset" string="إعادة تعيين المعايير" type="object" class="btn-secondary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title text-center mb-4">
                        <h2 class="text-primary font-weight-bold">
                            <i class="fa fa-archive me-2"/> منظومة الأرشيف الإلكتروني الموحد
                        </h2>
                        <h5 class="text-muted">
                            قطاع البلاط والبلوك - شركة أبناء صالح المديفر القابضة
                        </h5>
                    </div>

                    <!-- Level 1 to 4 Cascading Filters -->
                    <div class="card mb-4 border-primary">
                        <div class="card-header bg-primary text-white fw-bold">
                            <i class="fa fa-sitemap me-2"/> خطوات التحديد الهرمي (Hierarchical Filters)
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <label for="company_id" class="fw-bold"/>
                                    <field name="company_id" options="{'no_create': True}"/>
                                </div>
                                <div class="col-md-3">
                                    <label for="fiscal_year" class="fw-bold"/>
                                    <field name="fiscal_year"/>
                                </div>
                                <div class="col-md-3">
                                    <label for="department" class="fw-bold"/>
                                    <field name="department"/>
                                </div>
                                <div class="col-md-3">
                                    <label for="sub_app" class="fw-bold"/>
                                    <field name="sub_app"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Refined Criteria -->
                    <div class="card mb-4 border-info">
                        <div class="card-header bg-light fw-bold text-dark">
                            <i class="fa fa-filter me-2"/> محددات البحث التفصيلية (Refined Search Criteria)
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <label for="doc_number" class="fw-bold"/>
                                    <field name="doc_number" placeholder="مثال: INV/2026/000123 أو CR1/IN/04518"/>
                                </div>
                                <div class="col-md-4">
                                    <label for="partner_id" class="fw-bold"/>
                                    <field name="partner_id" options="{'no_create': True}" placeholder="اختيار العميل أو المورد..."/>
                                </div>
                                <div class="col-md-4">
                                    <label for="doc_type_id" class="fw-bold"/>
                                    <field name="doc_type_id" options="{'no_create': True}" placeholder="صورة الميزان، سند تسليم، إشعار سداد..."/>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-3">
                                    <label for="date_from" class="fw-bold"/>
                                    <field name="date_from"/>
                                </div>
                                <div class="col-md-3">
                                    <label for="date_to" class="fw-bold"/>
                                    <field name="date_to"/>
                                </div>
                                <div class="col-md-6">
                                    <label for="query_text" class="fw-bold"/>
                                    <field name="query_text" placeholder="بحث شامل في كافة الحقول والنصوص..."/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Search Results -->
                    <div class="card border-success">
                        <div class="card-header bg-success text-white fw-bold d-flex justify-content-between align-items-center">
                            <span><i class="fa fa-list-alt me-2"/> نتائج البحث المسترجعة</span>
                            <span class="badge bg-light text-dark">
                                <field name="result_count"/> مستند متطابق
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <field name="result_attachment_ids" mode="list" readonly="1">
                                <list string="المستندات المسترجعة" create="false" delete="false">
                                    <field name="doc_reference" string="رقم المستند"/>
                                    <field name="doc_date" string="تاريخ المستند"/>
                                    <field name="doc_type_id" string="نوع المستند"/>
                                    <field name="partner_id" string="اسم العميل أو المورد"/>
                                    <field name="name" string="اسم المرفق / الملف"/>
                                    <field name="file_size" widget="binary_size" string="الحجم"/>
                                    <field name="is_locked" string="حالة القفل"/>
                                    <field name="create_uid" string="المستخدم"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for the Search Dashboard -->
    <record id="action_archive_document_search" model="ir.actions.act_window">
        <field name="name">محرك البحث والاسترجاع الموحد بالأرشيف</field>
        <field name="res_model">archive.document.search</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
    </record>
</odoo>
