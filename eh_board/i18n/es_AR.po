#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"Hay una credencial guardada. Su valor nunca se devuelve a este diálogo. Al "
"introducir un nuevo secreto se sustituye la credencial de esta conexión."

