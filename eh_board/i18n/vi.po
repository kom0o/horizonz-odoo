#: code:addons/eh_board/static/src/board.xml:0
msgid "1 = raw value; 0.01 = divide by 100"
msgstr "1 = giá trị gốc; 0.01 = chia cho 100"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "1.2K"
msgstr "1.2K"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 trong khoảng mục tiêu; tăng tuyến tính từ 0 tại mỗi mốc cơ sở bên ngoài "
"đến 100 tại biên mục tiêu gần nhất, giới hạn từ 0 đến 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (thực tế − mức cơ sở) / (chỉ tiêu − mức cơ sở), giới hạn từ 0 đến 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (giá trị cơ sở − giá trị thực tế) / (giá trị cơ sở − giá trị mục "
"tiêu), giới hạn từ 0 đến 100."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
