#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "AI proposals support Odoo models, saved snapshots and guided queries."
msgstr ""
"Đề xuất AI hỗ trợ mô hình Odoo, ảnh chụp dữ liệu đã lưu và truy vấn có hướng"
