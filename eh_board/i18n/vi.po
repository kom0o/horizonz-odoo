msgstr "<h2>Tiêu đề</h2><p>Nội dung của bạn ở đây.</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "<p>First task</p><p>Second task</p>"
msgstr "<p>Công việc đầu tiên</p><p>Công việc thứ hai</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "A blank canvas"
msgstr "Một canvas trống"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__default_date_filter
msgid ""
"A built-in date range applied to this widget when the board's own date "
"filter is off."
msgstr ""
"Một khoảng ngày tích hợp sẵn áp dụng cho widget này khi bộ lọc ngày riêng "
"của bảng bị tắt."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this measure. Detach its business definition "
"before changing the calculation."
msgstr ""
"Một bảng điều khiển kinh doanh đang dùng phép đo này. Hãy tách định nghĩa "
"kinh doanh trước khi thay đổi phép tính."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this source. Detach its business definition before"
" changing the source or scope."
msgstr ""
"Một bảng điều khiển kinh doanh đang dùng nguồn này. Hãy tách định nghĩa kinh"
" doanh trước khi thay đổi nguồn hoặc phạm vi."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"Thông tin xác thực đã được lưu. Giá trị không bao giờ được trả về hộp thoại "
"này. Nhập bí mật mới sẽ thay thế thông tin xác thực của kết nối này."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "Người chỉnh sửa bảng điều khiển có thể tạo bảng đánh giá."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "Không thể thay đổi loại nguồn dữ liệu."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr ""
"Một mục tiêu cho KPI này. Mục tiêu 100 với giá trị 72 hiển thị 72% mục tiêu "
"trên thanh."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr "Một nhóm và tất cả các phần tử con phải dùng cùng một kỳ hiệu lực."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Truy vấn có hướng dẫn chỉ có thể dùng trên bảng điều khiển sở hữu truy vấn "
"đó."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "Truy vấn có hướng dẫn phải thuộc một bảng điều khiển."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr "Truy vấn có hướng dẫn yêu cầu nguồn so sánh thuộc bảng điều khiển."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "Bộ lọc danh sách yêu cầu từ 1 đến 100 giá trị."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr "Nút cha phải là nhóm có trọng số trong cùng bảng điều khiển."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposal may contain at most eight widgets."
msgstr "Một đề xuất chỉ được chứa tối đa tám tiện ích."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric could not be calculated. No widgets were changed."
msgstr ""
"Không thể tính một chỉ số được đề xuất. Không có tiện ích nào bị thay đổi."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric is unavailable with your current access rights."
msgstr ""
"Một chỉ số được đề xuất không khả dụng với quyền truy cập hiện tại của bạn."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A record count must not specify a value field."
msgstr "Phép đếm bản ghi không được chỉ định trường giá trị."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s showing %s."
msgstr "Danh sách bản ghi %s hiển thị %s."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s. Choose columns to display."
msgstr "Danh sách bản ghi %s. Chọn cột cần hiển thị."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A saved guided query cannot be moved to another dashboard or provider."
msgstr ""
"Không thể chuyển truy vấn có hướng dẫn đã lưu sang bảng điều khiển hoặc nhà "
"cung cấp khác."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr ""
"Không thể khôi phục một chỉ số của bảng đánh giá. Hãy khôi phục tiện ích "
"tương ứng trước khi nhập bảng đánh giá."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr "Không thể chuyển nút bảng đánh giá sang bảng điều khiển khác."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "Bảng đánh giá hỗ trợ tối đa 60 nút."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "Bảng đánh giá hỗ trợ tối đa năm cấp."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard tree cannot contain a cycle."
msgstr "Cây bảng đánh giá không được chứa chu trình."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A short note explaining what this widget measures. Appears as an info "
"tooltip on the card."
msgstr ""
"Một ghi chú ngắn giải thích widget này đo lường điều gì. Hiển thị dưới dạng "
"chú giải thông tin trên thẻ."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__sql_query
msgid ""
"A single read-only SELECT. First column is the category label; the remaining"
" numeric columns become measures. Dashboard Administrator only: other users "
"never receive query text."
msgstr ""
"Một câu lệnh SELECT chỉ đọc. Cột đầu tiên là nhãn danh mục; các cột số còn "
"lại trở thành chỉ số. Chỉ dành cho Quản trị viên bảng điều khiển: người dùng"
" khác không bao giờ nhận được nội dung truy vấn."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__domain
msgid ""
"A static filter applied before any runtime dashboard filter. A plain domain "
"literal - never an evaluated expression."
msgstr ""
"Một bộ lọc tĩnh được áp dụng trước bất kỳ bộ lọc bảng điều khiển thời gian "
"chạy nào. Là một domain literal thuần túy - không bao giờ là biểu thức được "
"đánh giá."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__domain
msgid "A static filter for this item, on top of the data source filter."
msgstr "Một bộ lọc tĩnh cho mục này, bổ sung bên trên bộ lọc nguồn dữ liệu."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A text block. Whatever you type renders as-is on the board."
msgstr ""
"Khối văn bản. Nội dung bạn nhập được hiển thị nguyên trạng trên bảng điều "
"khiển."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A transient/abstract model cannot be joined."
msgstr "Không thể nối mô hình tạm thời hoặc trừu tượng."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__credential_id
msgid "A vaulted credential for an external source (never inlined)."
msgstr ""
"Một thông tin xác thực được lưu trong kho bảo mật cho nguồn bên ngoài (không"
" bao giờ nhúng trực tiếp)."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/query_builder.js:0
msgid "A · Left side"
msgstr "A · Phía trái"

