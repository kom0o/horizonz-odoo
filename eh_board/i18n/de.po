#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "Eine Bewertungsübersicht unterstützt höchstens 60 Knoten."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
