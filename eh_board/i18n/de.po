#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "Ein Dashboard-Bearbeiter kann die Bewertungsübersicht erstellen."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "Der Typ einer Datenquelle kann nicht geändert werden."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr ""
"Ein Ziel für diesen KPI. Ziel 100 mit einem Wert von 72 zeigt 72% des Ziels "
"auf dem Balken an."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"Eine Gruppe und alle untergeordneten Elemente müssen denselben "
"Gültigkeitszeitraum verwenden."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Eine geführte Abfrage kann nur auf dem Dashboard verwendet werden, zu dem "
"sie gehört."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "Eine geführte Abfrage muss zu einem Dashboard gehören."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr ""
"Eine geführte Abfrage benötigt eine Vergleichsdatenquelle, die diesem "
"Dashboard gehört."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "Ein Listenfilter benötigt 1 bis 100 Werte."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr ""
"Das übergeordnete Element muss eine gewichtete Gruppe im selben Dashboard "
"sein."

