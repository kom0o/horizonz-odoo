msgstr ""
"100 × (Istwert − Ausgangswert) / (Zielwert − Ausgangswert), begrenzt auf 0 "
"bis 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
