msgstr "<h2>शीर्षक</h2><p>आपका पाठ यहाँ।</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "<p>First task</p><p>Second task</p>"
msgstr "<p>पहला कार्य</p><p>दूसरा कार्य</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "A blank canvas"
msgstr "एक खाली कैनवास"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__default_date_filter
msgid ""
"A built-in date range applied to this widget when the board's own date "
"filter is off."
msgstr ""
"जब बोर्ड का अपना दिनांक फ़िल्टर बंद हो, तब इस विजेट पर लागू होने वाली एक "
"अंतर्निहित दिनांक सीमा।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this measure. Detach its business definition "
"before changing the calculation."
msgstr ""
"एक व्यावसायिक डैशबोर्ड इस माप का उपयोग करता है। गणना बदलने से पहले इसकी "
"व्यावसायिक परिभाषा अलग करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this source. Detach its business definition before"
" changing the source or scope."
msgstr ""
"एक व्यावसायिक डैशबोर्ड इस स्रोत का उपयोग करता है। स्रोत या दायरा बदलने से "
"पहले इसकी व्यावसायिक परिभाषा अलग करें।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"एक क्रेडेंशियल सहेजा गया है। उसका मान इस संवाद में कभी वापस नहीं दिया जाता। "
"नया गोपनीय मान दर्ज करने पर इस कनेक्शन का क्रेडेंशियल बदल जाता है।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "डैशबोर्ड संपादक स्कोरकार्ड बना सकता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "डेटा स्रोत का प्रकार बदला नहीं जा सकता।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr ""
"इस KPI के लिए एक लक्ष्य। लक्ष्य 100 और मान 72 होने पर बार पर लक्ष्य का 72% "
"दिखता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"किसी समूह और उसके सभी अधीनस्थ तत्वों को एक ही प्रभावी अवधि का उपयोग करना "
"चाहिए।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"निर्देशित क्वेरी का उपयोग केवल उसी डैशबोर्ड पर किया जा सकता है जिससे वह "
"संबंधित है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "निर्देशित क्वेरी किसी डैशबोर्ड से संबंधित होनी चाहिए।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr ""
"निर्देशित क्वेरी के लिए डैशबोर्ड के स्वामित्व वाला तुलना स्रोत आवश्यक है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "सूची फ़िल्टर के लिए 1 से 100 मान आवश्यक हैं।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr "मूल नोड उसी डैशबोर्ड में भारित समूह होना चाहिए।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposal may contain at most eight widgets."
msgstr "एक प्रस्ताव में अधिकतम आठ विजेट हो सकते हैं।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric could not be calculated. No widgets were changed."
msgstr "प्रस्तावित मेट्रिक की गणना नहीं हो सकी। कोई विजेट नहीं बदला गया।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric is unavailable with your current access rights."
msgstr "आपके वर्तमान पहुँच अधिकारों से प्रस्तावित मेट्रिक उपलब्ध नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A record count must not specify a value field."
msgstr "रिकॉर्ड गणना में मान फ़ील्ड निर्दिष्ट नहीं होना चाहिए।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s showing %s."
msgstr "%s की रिकॉर्ड सूची जिसमें %s दिखता है।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s. Choose columns to display."
msgstr "%s की रिकॉर्ड सूची। दिखाने हेतु स्तंभ चुनें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A saved guided query cannot be moved to another dashboard or provider."
msgstr ""
"सहेजी गई निर्देशित क्वेरी को किसी अन्य डैशबोर्ड या प्रदाता में नहीं ले जाया "
"जा सकता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr ""
"स्कोरकार्ड का एक मापदंड बहाल नहीं हो सका। स्कोरकार्ड आयात करने से पहले उसका "
"विजेट बहाल करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr "स्कोरकार्ड नोड को दूसरे डैशबोर्ड में नहीं ले जाया जा सकता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "एक स्कोरकार्ड अधिकतम 60 नोड का समर्थन करता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "स्कोरकार्ड अधिकतम पाँच स्तरों का समर्थन करता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard tree cannot contain a cycle."
msgstr "स्कोरकार्ड वृक्ष में चक्र नहीं हो सकता।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A short note explaining what this widget measures. Appears as an info "
"tooltip on the card."
msgstr ""
"यह विजेट क्या मापता है, इसे समझाने वाली एक संक्षिप्त टिप्पणी। कार्ड पर सूचना"
" टूलटिप के रूप में दिखती है।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__sql_query
msgid ""
"A single read-only SELECT. First column is the category label; the remaining"
" numeric columns become measures. Dashboard Administrator only: other users "
"never receive query text."
msgstr ""
"केवल पढ़ने हेतु एक SELECT। पहला स्तंभ श्रेणी का लेबल है; शेष संख्यात्मक "
"स्तंभ माप बनते हैं। केवल डैशबोर्ड प्रशासक हेतु: अन्य उपयोगकर्ताओं को क्वेरी "
"का पाठ नहीं मिलता।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__domain
msgid ""
"A static filter applied before any runtime dashboard filter. A plain domain "
"literal - never an evaluated expression."
msgstr ""
"किसी भी रनटाइम डैशबोर्ड फ़िल्टर से पहले लागू होने वाला एक स्थिर फ़िल्टर। एक "
"सादा domain लिटरल - कभी भी मूल्यांकित अभिव्यक्ति नहीं।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__domain
msgid "A static filter for this item, on top of the data source filter."
msgstr "इस आइटम के लिए एक स्थिर फ़िल्टर, डेटा स्रोत फ़िल्टर के अतिरिक्त।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A text block. Whatever you type renders as-is on the board."
msgstr "पाठ खंड। आप जो लिखते हैं वह डैशबोर्ड पर वैसा ही दिखता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A transient/abstract model cannot be joined."
msgstr "अस्थायी या अमूर्त मॉडल को जोड़ा नहीं जा सकता।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__credential_id
msgid "A vaulted credential for an external source (never inlined)."
msgstr ""
"किसी बाहरी स्रोत के लिए वॉल्ट में सुरक्षित क्रेडेंशियल (कभी इनलाइन नहीं)।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/query_builder.js:0
msgid "A · Left side"
msgstr "A · बायाँ पक्ष"

#. module: eh_board
#: model:ir.ui.menu,name:eh_board.menu_eh_board_ai_settings
msgid "AI Settings"
msgstr "AI सेटिंग्स"

#. module: eh_board
#: model:ir.model.fields,field_description:eh_board.field_res_config_settings__eh_board_ai_authoring_max_tokens
msgid "AI authoring output token limit"
msgstr "AI निर्माण के आउटपुट टोकन की सीमा"

#. module: eh_board
