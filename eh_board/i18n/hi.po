#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "The existing source filter is preserved."
msgstr "स्रोत का मौजूदा फ़िल्टर बना रहता है।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_measure__field_id
msgid "The field to aggregate. Leave empty for a record count."
msgstr "एकत्रित करने के लिए फ़ील्ड। रिकॉर्ड गणना के लिए खाली छोड़ें।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_measure__column_id
msgid "The file column to aggregate (for a file data source)."
msgstr "समेकित करने वाला फ़ाइल स्तंभ (फ़ाइल डेटा स्रोत हेतु)।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The formula or its label is too long."
msgstr "सूत्र या उसका लेबल बहुत लंबा है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The guided query is invalid or too large."
msgstr "निर्देशित क्वेरी अमान्य है या बहुत बड़ी है।"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__item_type
msgid ""
"The kind of widget. Every type is a registered strategy - adding one never "
"edits this model."
msgstr ""
"विजेट का प्रकार। हर प्रकार एक पंजीकृत रणनीति है - किसी को जोड़ने से यह मॉडल "
"कभी संपादित नहीं होता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The metric widget was removed. Choose another widget."
msgstr "सूचक विजेट हटा दिया गया है। कोई दूसरा विजेट चुनें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The page limit was reached before the end of the feed. Narrow the query or "
"increase the bounded page limit; partial totals were not saved."
msgstr ""
"फ़ीड समाप्त होने से पहले पृष्ठ सीमा पहुँच गई। क्वेरी सीमित करें या अधिकतम "
"पृष्ठ सीमा बढ़ाएँ; अधूरे कुल सहेजे नहीं गए।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
#: code:addons/eh_board/models/eh_board_template.py:0
msgid "The portable scorecard definition is invalid."
msgstr "स्थानांतरित किए जा सकने वाले स्कोरकार्ड की परिभाषा अमान्य है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "The proposal includes unsupported widget settings."
msgstr "प्रस्ताव में असमर्थित विजेट सेटिंग हैं।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The proposal is too large. Start a new proposal with a shorter request."
msgstr "प्रस्ताव बहुत बड़ा है। छोटे अनुरोध से नया प्रस्ताव शुरू करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The proposal needs a supported metric or an explanation of unavailable data."
msgstr ""
"प्रस्ताव में समर्थित मेट्रिक या अनुपलब्ध डेटा का स्पष्टीकरण होना चाहिए।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The records to chart. Search by name or technical model (sale.report, "
"account.move.line). Example: Contact for customers, Sales Order for revenue."
msgstr ""
"चार्ट में दिखाने वाले रिकॉर्ड। नाम या तकनीकी मॉडल (sale.report, "
"account.move.line) से खोजें। उदाहरण: ग्राहकों हेतु संपर्क, राजस्व हेतु "
"विक्रय आदेश।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The refresh exceeded its time limit. Reduce the requested range or page "
"count."
msgstr ""
"रीफ़्रेश समय सीमा से अधिक हो गया। माँगी गई रेंज या पृष्ठ संख्या घटाएँ।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The response exceeds a connector limit: 8 MB, 10,000 rows or 60 columns. "
"Narrow the source query."
msgstr ""
"प्रतिक्रिया कनेक्टर की सीमा से अधिक है: 8 MB, 10,000 पंक्तियाँ या 60 कॉलम। "
"स्रोत क्वेरी सीमित करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The response is not valid UTF-8 JSON."
msgstr "प्रतिक्रिया मान्य UTF-8 JSON नहीं है।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The rich text shown in this block, e.g. a section title, notes, or "
"instructions for the board."
msgstr ""
"इस ब्लॉक में दिखाया गया रिच टेक्स्ट, जैसे अनुभाग शीर्षक, नोट्स या बोर्ड के "
"लिए निर्देश।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_template.py:0
msgid "The saved widget could not be restored: %s"
msgstr "सहेजा गया विजेट पुनर्स्थापित नहीं हो सका: %s"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard changed in another session. Reload it before saving."
msgstr ""
"स्कोरकार्ड दूसरे सत्र में बदल गया है। सहेजने से पहले उसे फिर से लोड करें।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.js:0
msgid "The scorecard could not be loaded. Try again."
msgstr "स्कोरकार्ड लोड नहीं हो सका। फिर से प्रयास करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard definition contains unsupported fields."
msgstr "स्कोरकार्ड की परिभाषा में असमर्थित फ़ील्ड हैं।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard definition is invalid or too large."
msgstr "स्कोरकार्ड की परिभाषा अमान्य या बहुत बड़ी है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "The selected model is no longer available."
msgstr "चयनित मॉडल अब उपलब्ध नहीं है।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.js:0
msgid "The service-account JSON must be smaller than 20 KB."
msgstr "सेवा-खाता JSON 20 KB से छोटा होना चाहिए।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid ""
"The snapshot is shared with the dashboard audience; Odoo record rules do not"
" filter its rows."
msgstr ""
"स्नैपशॉट डैशबोर्ड के दर्शकों के साथ साझा किया जाता है; Odoo के रिकॉर्ड नियम "
"उसकी पंक्तियों को फ़िल्टर नहीं करते।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The source is busy or unavailable. Refresh will retry with backoff."
msgstr ""
"स्रोत व्यस्त या अनुपलब्ध है। रीफ़्रेश बढ़ते अंतराल के साथ फिर प्रयास करेगा।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The source owns its grouping, measures and row filters."
msgstr "स्रोत अपने समूहन, मापों और पंक्ति फ़िल्टर को निर्धारित करता है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The source redirected the request. Enter its final HTTPS address; redirects "
"are not followed."
msgstr ""
"स्रोत ने अनुरोध रीडायरेक्ट किया। उसका अंतिम HTTPS पता दर्ज करें; रीडायरेक्ट "
"का अनुसरण नहीं किया जाता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The source rejected the request. Check its endpoint and configuration."
msgstr "स्रोत ने अनुरोध अस्वीकार किया। उसका एंडपॉइंट और कॉन्फ़िगरेशन जाँचें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The source schema changed or contains unsupported values. The last valid "
"snapshot is retained; restore the column names and types or create a new "
"source for the new schema."
msgstr ""
"स्रोत की संरचना बदल गई या उसमें असमर्थित मान हैं। अंतिम मान्य स्नैपशॉट रखा "
"गया है; कॉलम नाम और प्रकार पुनर्स्थापित करें या नई संरचना के लिए नया स्रोत "
"बनाएँ।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/datasources/file.py:0
msgid ""
"The table filter uses an unsupported operator, incompatible value or missing"
" column. Correct the filter before viewing these figures."
msgstr ""
"तालिका फ़िल्टर में असमर्थित ऑपरेटर, असंगत मान या गायब कॉलम है। ये आँकड़े "
"देखने से पहले फ़िल्टर ठीक करें।"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "The title shown on the card. Example: \"Revenue by month\"."
msgstr "कार्ड पर दिखाया गया शीर्षक। उदाहरण: \"माह के अनुसार राजस्व\"।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "The uploaded file is not valid base64 data."
msgstr "अपलोड की गई फ़ाइल मान्य base64 डेटा नहीं है।"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_item__color_mode__theme
msgid "Theme palette"
msgstr "थीम पैलेट"

#. module: eh_board
#: model:ir.model.fields,field_description:eh_board.field_eh_board_item__secondary_dimension_id
msgid "Then by"
msgstr "फिर इसके अनुसार"

#. module: eh_board
#: model:ir.model.fields,field_description:eh_board.field_eh_board_item__secondary_column_id
msgid "Then by column"
msgstr "फिर स्तंभ के अनुसार"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "Then grouped by %s."
msgstr "फिर %s के अनुसार समूहित।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"These measures have incompatible units. Compare counts with counts, numbers "
"with numbers, or monetary fields in the same company currency."
msgstr ""
"इन मापों की इकाइयाँ असंगत हैं। गिनती की तुलना गिनती से, संख्या की संख्या से,"
" या मौद्रिक फ़ील्ड की उसी कंपनी मुद्रा वाले फ़ील्ड से करें।"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_month
msgid "This Month"
msgstr "इस महीने"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_quarter
msgid "This Quarter"
msgstr "इस तिमाही"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_week
msgid "This Week"
msgstr "इस सप्ताह"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_year
msgid "This Year"
msgstr "इस साल"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis filters specific record IDs. Replace those filters with "
"portable names, states or dates before exporting or importing it."
msgstr ""
"यह विश्लेषण विशिष्ट रिकॉर्ड आईडी को फ़िल्टर करता है। निर्यात या आयात करने से"
" पहले इन फ़िल्टरों को पोर्टेबल नामों, स्थितियों या तिथियों से बदलें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis owns its grouping, measures and filters. Create a new guided "
"query to change its calculation."
msgstr ""
"यह विश्लेषण अपने समूहन, मापों और फ़िल्टर को निर्धारित करता है। गणना बदलने के"
" लिए नई निर्देशित क्वेरी बनाएँ।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis uses separate filters for each side. Edit the guided query "
"instead of applying a common row filter."
msgstr ""
"यह विश्लेषण प्रत्येक पक्ष के लिए अलग फ़िल्टर उपयोग करता है। साझा पंक्ति "
"फ़िल्टर लगाने के बजाय निर्देशित क्वेरी संपादित करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"This business metric is unavailable for your installed apps or access "
"rights."
msgstr ""
"यह व्यावसायिक मेट्रिक आपके स्थापित ऐप या पहुँच अधिकारों के लिए उपलब्ध नहीं "
"है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"This business pack is unavailable for your installed apps or access rights."
msgstr ""
"यह व्यावसायिक पैक आपके स्थापित ऐप या पहुँच अधिकारों के लिए उपलब्ध नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid "This chart is not supported by the business metric."
msgstr "यह चार्ट व्यावसायिक मेट्रिक द्वारा समर्थित नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This comparison exceeds 1,000 groups on one side. Add filters before "
"previewing; partial totals are not displayed."
msgstr ""
"इस तुलना के एक पक्ष में 1,000 से अधिक समूह हैं। पूर्वावलोकन से पहले फ़िल्टर "
"जोड़ें; अधूरे कुल नहीं दिखाए जाते।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/lib/aggregation.py:0
msgid "This dashboard uses a field you are not allowed to read."
msgstr ""
"यह डैशबोर्ड ऐसा फ़ील्ड उपयोग करता है जिसे पढ़ने की आपको अनुमति नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_item.py:0
msgid ""
"This drill path is no longer available. Refresh the dashboard and drill "
"again."
msgstr ""
"यह ड्रिल पथ अब उपलब्ध नहीं है। डैशबोर्ड रीफ़्रेश करें और फिर विस्तार देखें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "This field cannot be used in the selected query operation."
msgstr "इस फ़ील्ड का उपयोग चुनी गई क्वेरी क्रिया में नहीं हो सकता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "This field is not available with your current access rights."
msgstr "यह फ़ील्ड आपके वर्तमान पहुँच अधिकारों के साथ उपलब्ध नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "This guided-query version is not supported."
msgstr "निर्देशित क्वेरी का यह संस्करण समर्थित नहीं है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"This metric cannot be previewed with your current configuration and access "
"rights."
msgstr ""
"आपके वर्तमान कॉन्फ़िगरेशन और पहुँच अधिकारों से इस मेट्रिक का पूर्वावलोकन "
"नहीं हो सकता।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"This metric could not be calculated. Review its definition and source "
"configuration."
msgstr ""
"इस मेट्रिक की गणना नहीं हो सकी। उसकी परिभाषा और स्रोत कॉन्फ़िगरेशन की "
"समीक्षा करें।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid "This metric has a fixed date basis."
msgstr "इस मेट्रिक का दिनांक आधार निर्धारित है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"This metric is unavailable, blocked or stale for your current view. Its "
"score has not been calculated."
msgstr ""
"यह सूचक वर्तमान दृश्य के लिए अनुपलब्ध, अवरुद्ध या पुराना है। इसका स्कोर नहीं"
" निकाला गया है।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid ""
"This model has no direct company field. Your record rules and selected "
"companies determine access."
msgstr ""
"इस मॉडल में सीधे कंपनी का फ़ील्ड नहीं है। आपके रिकॉर्ड नियम और चयनित "
"कंपनियाँ पहुँच निर्धारित करती हैं।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "This model's company scope cannot be verified with your access rights."
