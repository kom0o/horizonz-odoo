msgstr "1.2K"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"लक्ष्य सीमा के भीतर 100; प्रत्येक बाहरी आधार मान पर 0 से निकटतम लक्ष्य सीमा "
"पर 100 तक रैखिक प्रगति, 0 और 100 के बीच सीमित।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (वास्तविक मान − आधारमान) / (लक्ष्यमान − आधारमान), 0 और 100 के बीच "
"सीमित।"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (आधार मान − वास्तविक मान) / (आधार मान − लक्ष्य मान), परिणाम 0 से 100 "
"के बीच सीमित है।"

