#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 ضمن النطاق المستهدف؛ تقدم خطي من 0 عند كل خط أساس خارجي إلى 100 عند أقرب"
" حد مستهدف، مع حصر النتيجة بين 0 و100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (القيمة الفعلية − القيمة الأساسية) / (القيمة المستهدفة − القيمة "
"الأساسية)، بحدود من 0 إلى 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (القيمة الأساسية − القيمة الفعلية) / (القيمة الأساسية − القيمة "
"المستهدفة)، مع حصر النتيجة بين 0 و100."

