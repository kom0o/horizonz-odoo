"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (werkelijke waarde − basiswaarde) / (streefwaarde − basiswaarde), "
"begrensd tussen 0 en 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
