#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"Een groep en alle onderliggende onderdelen moeten dezelfde "
"geldigheidsperiode gebruiken."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Een begeleide query kan alleen worden gebruikt op het dashboard waartoe deze"
" behoort."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
