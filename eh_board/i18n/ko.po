msgstr "저장된 안내형 쿼리는 다른 대시보드나 제공자로 이동할 수 없습니다."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr "성과표 지표를 복원하지 못했습니다. 성과표를 가져오기 전에 해당 위젯을 복원하세요."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr "성과표 노드를 다른 대시보드로 이동할 수 없습니다."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "성과표는 최대 60개의 노드를 지원합니다."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "성과표는 최대 5단계까지 지원합니다."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
