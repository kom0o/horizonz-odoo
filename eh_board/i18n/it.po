#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 nell’intervallo obiettivo; avanzamento lineare da 0 a ciascun valore di "
"riferimento esterno a 100 al limite obiettivo più vicino, limitato tra 0 e "
"100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (valore effettivo − valore di riferimento) / (valore obiettivo − "
"valore di riferimento), limitato tra 0 e 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (valore iniziale − valore effettivo) / (valore iniziale − obiettivo), "
"limitato tra 0 e 100."

