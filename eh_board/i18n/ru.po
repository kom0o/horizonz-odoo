#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "That data source does not belong to this dashboard."
msgstr "Этот источник данных не принадлежит данной панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "That filter does not belong to this dashboard."
msgstr "Этот фильтр не принадлежит данной панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "That layout version does not belong to this dashboard."
msgstr "Эта версия макета не принадлежит данной панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "That model cannot be used as a dashboard source."
msgstr "Эту модель нельзя использовать как источник панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "That period would change this metric's date policy."
msgstr "Этот период изменит правила дат показателя."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "That widget does not belong to this dashboard."
msgstr "Этот виджет не принадлежит данной панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "The AI proposal exceeded the response limit."
msgstr "Предложение ИИ превысило лимит ответа."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The AI provider could not return a proposal. Your dashboard is unchanged. "
"Try again or use Business Packs."
msgstr ""
"Провайдер ИИ не смог вернуть предложение. Панель не изменена. Повторите "
"попытку или используйте бизнес-пакеты."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The AI returned an invalid or unsupported proposal. Your dashboard is "
"unchanged. Rephrase the request using the available metrics."
msgstr ""
"ИИ вернул недопустимое или неподдерживаемое предложение. Панель не изменена."
" Переформулируйте запрос с использованием доступных показателей."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The HTTPS connection failed. Check the destination, certificate and network "
"access."
msgstr ""
"Ошибка подключения HTTPS. Проверьте адрес назначения, сертификат и доступ к "
"сети."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The JSON pointer does not identify the expected data. Use an explicit path "
"such as /data/items."
msgstr ""
"JSON-указатель не определяет ожидаемые данные. Используйте явный путь, "
"например /data/items."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__model_id
#: model:ir.model.fields,help:eh_board.field_eh_board_item__model_id
#: model:ir.model.fields,help:eh_board.field_eh_board_measure__model_id
msgid "The Odoo model to aggregate (for the Odoo-model provider)."
msgstr "Модель Odoo для агрегирования (для поставщика модели Odoo)."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/query_builder.js:0
msgid "The analysis could not be completed."
msgstr "Не удалось завершить анализ."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The bearer token has expired. Replace it and set its expiry, or use a Google"
" service account for unattended refresh."
msgstr ""
"Срок bearer-токена истёк. Замените его и укажите срок действия или "
"используйте сервисный аккаунт Google для автоматического обновления."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The card's highlight colour. Tiles use it as their fill; charts use it for "
"the first series."
msgstr ""
"Цвет выделения карточки. Плитки используют его как заливку; диаграммы - для "
"первой серии."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The credential is too large."
msgstr "Учётные данные слишком велики."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "The dashboard proposal has an unsupported format."
msgstr "Формат предложения панели не поддерживается."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "The dashboard's title, shown in the header and the switcher."
msgstr "Заголовок панели, отображаемый в шапке и переключателе."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The date filter the board starts on. This month means it always opens scoped"
" to the current month."
msgstr ""
"Фильтр даты, с которого открывается доска. \"Этот месяц\" означает, что она "
"всегда открывается в рамках текущего месяца."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_dashboard__default_date_preset
msgid ""
"The date range this dashboard opens with (the board date filter's start "
"value)."
msgstr ""
"Диапазон дат, с которым открывается эта панель (начальное значение фильтра "
"даты доски)."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "The existing source filter is preserved."
msgstr "Существующий фильтр источника сохраняется."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_measure__field_id
msgid "The field to aggregate. Leave empty for a record count."
msgstr "Поле для агрегирования. Оставьте пустым для подсчёта записей."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_measure__column_id
msgid "The file column to aggregate (for a file data source)."
msgstr "Столбец файла для агрегирования (для файлового источника данных)."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The formula or its label is too long."
msgstr "Формула или её название слишком длинные."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The guided query is invalid or too large."
msgstr "Пошаговый запрос недействителен или слишком велик."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__item_type
msgid ""
"The kind of widget. Every type is a registered strategy - adding one never "
"edits this model."
msgstr ""
"Тип виджета. Каждый тип - это зарегистрированная стратегия; добавление типа "
"никогда не изменяет эту модель."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The metric widget was removed. Choose another widget."
msgstr "Виджет показателя удалён. Выберите другой виджет."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The page limit was reached before the end of the feed. Narrow the query or "
"increase the bounded page limit; partial totals were not saved."
msgstr ""
"Лимит страниц достигнут до конца потока данных. Сузьте запрос или увеличьте "
"ограничение страниц; неполные итоги не сохранены."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
#: code:addons/eh_board/models/eh_board_template.py:0
msgid "The portable scorecard definition is invalid."
msgstr "Определение переносимой оценочной карты недопустимо."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "The proposal includes unsupported widget settings."
msgstr "Предложение содержит неподдерживаемые настройки виджетов."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The proposal is too large. Start a new proposal with a shorter request."
msgstr "Предложение слишком велико. Начните новое с более коротким запросом."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"The proposal needs a supported metric or an explanation of unavailable data."
msgstr ""
"Предложение должно содержать поддерживаемый показатель или объяснение "
"недоступности данных."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The records to chart. Search by name or technical model (sale.report, "
"account.move.line). Example: Contact for customers, Sales Order for revenue."
msgstr ""
"Записи для графика. Поиск по имени или технической модели (sale.report, "
"account.move.line). Например: Контакт для клиентов, Заказ на продажу для "
"выручки."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The refresh exceeded its time limit. Reduce the requested range or page "
"count."
msgstr ""
"Обновление превысило лимит времени. Уменьшите запрашиваемый диапазон или "
"число страниц."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The response exceeds a connector limit: 8 MB, 10,000 rows or 60 columns. "
"Narrow the source query."
msgstr ""
"Ответ превышает лимит коннектора: 8 МБ, 10 000 строк или 60 столбцов. Сузьте"
" запрос к источнику."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The response is not valid UTF-8 JSON."
msgstr "Ответ не является допустимым JSON в UTF-8."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"The rich text shown in this block, e.g. a section title, notes, or "
"instructions for the board."
msgstr ""
"Форматированный текст в этом блоке, например заголовок раздела, заметки или "
"инструкции для доски."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_template.py:0
msgid "The saved widget could not be restored: %s"
msgstr "Не удалось восстановить сохраненный виджет: %s"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard changed in another session. Reload it before saving."
msgstr ""
"Оценочная карта изменена в другом сеансе. Перезагрузите её перед "
"сохранением."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.js:0
msgid "The scorecard could not be loaded. Try again."
msgstr "Не удалось загрузить оценочную карту. Попробуйте ещё раз."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard definition contains unsupported fields."
msgstr "Определение оценочной карты содержит неподдерживаемые поля."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "The scorecard definition is invalid or too large."
msgstr "Определение оценочной карты недопустимо или слишком велико."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid "The selected model is no longer available."
msgstr "Выбранная модель больше недоступна."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.js:0
msgid "The service-account JSON must be smaller than 20 KB."
msgstr "JSON сервисного аккаунта должен быть меньше 20 КБ."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid ""
"The snapshot is shared with the dashboard audience; Odoo record rules do not"
" filter its rows."
msgstr ""
"Снимок доступен аудитории панели; правила записей Odoo не фильтруют его "
"строки."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The source is busy or unavailable. Refresh will retry with backoff."
msgstr ""
"Источник занят или недоступен. Обновление повторится с увеличивающейся "
"задержкой."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "The source owns its grouping, measures and row filters."
msgstr "Источник определяет свою группировку, показатели и фильтры строк."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The source redirected the request. Enter its final HTTPS address; redirects "
"are not followed."
msgstr ""
"Источник перенаправил запрос. Укажите конечный HTTPS-адрес; перенаправления "
"не выполняются."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid "The source rejected the request. Check its endpoint and configuration."
msgstr "Источник отклонил запрос. Проверьте конечную точку и настройки."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_remote.py:0
msgid ""
"The source schema changed or contains unsupported values. The last valid "
"snapshot is retained; restore the column names and types or create a new "
"source for the new schema."
msgstr ""
"Схема источника изменилась или содержит неподдерживаемые значения. Последний"
" действительный снимок сохранён; восстановите имена и типы столбцов либо "
"создайте новый источник для новой схемы."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/datasources/file.py:0
msgid ""
"The table filter uses an unsupported operator, incompatible value or missing"
" column. Correct the filter before viewing these figures."
msgstr ""
"Фильтр таблицы использует неподдерживаемый оператор, несовместимое значение "
"или отсутствующий столбец. Исправьте фильтр перед просмотром показателей."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "The title shown on the card. Example: \"Revenue by month\"."
msgstr "Заголовок, отображаемый на карточке. Пример: \"Выручка по месяцам\"."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "The uploaded file is not valid base64 data."
msgstr "Загруженный файл не содержит допустимых данных base64."

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_item__color_mode__theme
msgid "Theme palette"
msgstr "Палитра темы"

#. module: eh_board
#: model:ir.model.fields,field_description:eh_board.field_eh_board_item__secondary_dimension_id
msgid "Then by"
msgstr "Затем по"

#. module: eh_board
#: model:ir.model.fields,field_description:eh_board.field_eh_board_item__secondary_column_id
msgid "Then by column"
msgstr "Затем по столбцу"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "Then grouped by %s."
msgstr "Затем группировка по %s."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"These measures have incompatible units. Compare counts with counts, numbers "
"with numbers, or monetary fields in the same company currency."
msgstr ""
"Единицы этих мер несовместимы. Сравнивайте количества с количествами, числа "
"с числами или денежные поля в одной валюте компании."

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_month
msgid "This Month"
msgstr "Этот месяц"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_quarter
msgid "This Quarter"
msgstr "Этот квартал"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_week
msgid "This Week"
msgstr "На этой неделе"

#. module: eh_board
#: model:ir.model.fields.selection,name:eh_board.selection__eh_board_filter__date_preset__this_year
msgid "This Year"
msgstr "В этом году"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis filters specific record IDs. Replace those filters with "
"portable names, states or dates before exporting or importing it."
msgstr ""
"Этот анализ фильтрует конкретные идентификаторы записей. Перед экспортом или"
" импортом замените эти фильтры переносимыми названиями, статусами или "
"датами."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis owns its grouping, measures and filters. Create a new guided "
"query to change its calculation."
msgstr ""
"Этот анализ определяет свою группировку, показатели и фильтры. Создайте "
"новый управляемый запрос, чтобы изменить расчёт."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This analysis uses separate filters for each side. Edit the guided query "
"instead of applying a common row filter."
msgstr ""
"В этом анализе используются отдельные фильтры для каждой стороны. Измените "
"управляемый запрос вместо применения общего фильтра строк."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"This business metric is unavailable for your installed apps or access "
"rights."
msgstr ""
"Этот бизнес-показатель недоступен для установленных приложений или ваших "
"прав доступа."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"This business pack is unavailable for your installed apps or access rights."
msgstr ""
"Этот бизнес-пакет недоступен для установленных приложений или ваших прав "
"доступа."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid "This chart is not supported by the business metric."
msgstr "Эта диаграмма не поддерживается бизнес-показателем."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid ""
"This comparison exceeds 1,000 groups on one side. Add filters before "
"previewing; partial totals are not displayed."
msgstr ""
"В этом сравнении одна сторона превышает 1000 групп. Добавьте фильтры перед "
"предпросмотром; частичные итоги не отображаются."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/lib/aggregation.py:0
msgid "This dashboard uses a field you are not allowed to read."
msgstr "Эта панель использует поле, которое вам не разрешено читать."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_item.py:0
msgid ""
"This drill path is no longer available. Refresh the dashboard and drill "
"again."
msgstr ""
"Этот путь детализации больше недоступен. Обновите панель и повторите "
"детализацию."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "This field cannot be used in the selected query operation."
msgstr "Это поле нельзя использовать в выбранной операции запроса."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "This field is not available with your current access rights."
msgstr "Это поле недоступно с вашими текущими правами доступа."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "This guided-query version is not supported."
msgstr "Эта версия пошагового запроса не поддерживается."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"This metric cannot be previewed with your current configuration and access "
"rights."
msgstr ""
"Предпросмотр этого показателя невозможен с текущими настройками и правами "
"доступа."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid ""
"This metric could not be calculated. Review its definition and source "
"configuration."
msgstr ""
"Не удалось рассчитать этот показатель. Проверьте определение и настройки "
"источника."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid "This metric has a fixed date basis."
msgstr "У этого показателя фиксированная основа дат."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"This metric is unavailable, blocked or stale for your current view. Its "
"score has not been calculated."
msgstr ""
"Этот показатель недоступен, заблокирован или устарел для текущего "
"представления. Его оценка не рассчитана."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring_scope.py:0
msgid ""
"This model has no direct company field. Your record rules and selected "
