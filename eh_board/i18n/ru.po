msgstr "1.2K"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 в целевом диапазоне; линейный рост от 0 на каждой внешней базовой "
"границе до 100 на ближайшей целевой границе, с ограничением от 0 до 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (фактическое значение − базовое значение) / (целевое значение − "
"базовое значение), с ограничением от 0 до 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (базовое значение − фактическое значение) / (базовое значение − "
"целевое значение), с ограничением от 0 до 100."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "<h2>Heading</h2><p>Your text here.</p>"
msgstr "<h2>Заголовок</h2><p>Ваш текст здесь.</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "<p>First task</p><p>Second task</p>"
msgstr "<p>Первое задание</p><p>Второе задание</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "A blank canvas"
msgstr "Пустой холст"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__default_date_filter
msgid ""
"A built-in date range applied to this widget when the board's own date "
"filter is off."
msgstr ""
"Встроенный диапазон дат, применяемый к этому виджету, когда собственный "
"фильтр дат доски выключен."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this measure. Detach its business definition "
"before changing the calculation."
msgstr ""
"Эта мера используется на бизнес-панели. Перед изменением расчёта отсоедините"
" её бизнес-определение."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this source. Detach its business definition before"
" changing the source or scope."
msgstr ""
"Этот источник используется на бизнес-панели. Перед изменением источника или "
"охвата отсоедините бизнес-определение."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"Учётные данные сохранены. Их значение никогда не возвращается в это окно. "
"Ввод нового секрета заменяет учётные данные этого подключения."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "Редактор панели может создать оценочную карту."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "Тип источника данных изменить нельзя."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr ""
"Цель для этого KPI. Цель 100 при значении 72 показывает на шкале 72% от "
"цели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"Группа и все её дочерние элементы должны использовать один и тот же период "
"действия."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Управляемый запрос можно использовать только на панели, которой он "
"принадлежит."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "Управляемый запрос должен принадлежать панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr ""
"Для управляемого запроса нужен источник сравнения, принадлежащий этой "
"панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "Для фильтра по списку требуется от 1 до 100 значений."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr "Родительский узел должен быть взвешенной группой на той же панели."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposal may contain at most eight widgets."
msgstr "Предложение может содержать не более восьми виджетов."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric could not be calculated. No widgets were changed."
msgstr "Не удалось рассчитать предложенный показатель. Виджеты не изменены."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric is unavailable with your current access rights."
msgstr "Предложенный показатель недоступен с вашими текущими правами."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A record count must not specify a value field."
msgstr "Для подсчёта записей нельзя указывать поле значения."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s showing %s."
msgstr "Список записей %s с полями %s."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s. Choose columns to display."
msgstr "Список записей %s. Выберите столбцы для отображения."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A saved guided query cannot be moved to another dashboard or provider."
msgstr ""
"Сохранённый управляемый запрос нельзя переместить на другую панель или к "
"другому поставщику данных."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr ""
"Не удалось восстановить показатель оценочной карты. Восстановите его виджет "
"перед импортом оценочной карты."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr "Узел оценочной карты нельзя перенести на другую панель."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "Оценочная карта поддерживает не более 60 узлов."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "Оценочная карта поддерживает не более пяти уровней."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard tree cannot contain a cycle."
msgstr "Дерево оценочной карты не может содержать цикл."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A short note explaining what this widget measures. Appears as an info "
"tooltip on the card."
msgstr ""
"Короткая заметка, поясняющая, что измеряет этот виджет. Отображается как "
"всплывающая подсказка на карточке."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__sql_query
msgid ""
"A single read-only SELECT. First column is the category label; the remaining"
" numeric columns become measures. Dashboard Administrator only: other users "
"never receive query text."
msgstr ""
"Один запрос SELECT только для чтения. Первый столбец содержит подпись "
"категории, остальные числовые столбцы становятся показателями. Только для "
"администратора панели: другие пользователи никогда не получают текст "
"запроса."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__domain
msgid ""
"A static filter applied before any runtime dashboard filter. A plain domain "
"literal - never an evaluated expression."
msgstr ""
"Статический фильтр, применяемый до любого фильтра панели во время "
"выполнения. Простой литерал domain — никогда не вычисляемое выражение."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__domain
msgid "A static filter for this item, on top of the data source filter."
msgstr ""
"Статический фильтр для этого элемента, дополняющий фильтр источника данных."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A text block. Whatever you type renders as-is on the board."
msgstr "Текстовый блок. Введённый текст отображается на панели без изменений."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A transient/abstract model cannot be joined."
msgstr "Временную или абстрактную модель нельзя использовать в соединении."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__credential_id
msgid "A vaulted credential for an external source (never inlined)."
msgstr ""
"Учётные данные, хранящиеся в хранилище, для внешнего источника (никогда не "
"встраиваются в код)."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/query_builder.js:0
