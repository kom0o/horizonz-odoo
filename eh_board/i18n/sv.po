msgstr ""
"Aktuella filter har sparats för schemalagda sammanfattningar. Relativa datum"
" flyttas fram automatiskt."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/ui_text.js:0
msgid "Current layout"
msgstr "Aktuell layout"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/lib/business_metrics.py:0
