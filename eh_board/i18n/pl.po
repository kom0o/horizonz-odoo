msgstr "1.2K"

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 w zakresie docelowym; liniowy wzrost od 0 przy każdej zewnętrznej "
"wartości bazowej do 100 przy najbliższej granicy celu, ograniczony do 0–100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (wartość rzeczywista − wartość bazowa) / (wartość docelowa − wartość "
"bazowa), z ograniczeniem do zakresu od 0 do 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (wartość bazowa − wartość rzeczywista) / (wartość bazowa − wartość "
"docelowa), z ograniczeniem do zakresu od 0 do 100."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "<h2>Heading</h2><p>Your text here.</p>"
msgstr "<h2>Nagłówek</h2><p>Twój tekst tutaj.</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
