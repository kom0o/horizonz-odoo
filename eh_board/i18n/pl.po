msgstr "<p>Pierwsze zadanie</p><p>Drugie zadanie</p>"

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "A blank canvas"
msgstr "Pusty obszar roboczy"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__default_date_filter
msgid ""
"A built-in date range applied to this widget when the board's own date "
"filter is off."
msgstr ""
"Wbudowany zakres dat stosowany do tego widżetu, gdy własny filtr dat tablicy"
" jest wyłączony."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this measure. Detach its business definition "
"before changing the calculation."
msgstr ""
"Ta miara jest używana przez pulpit biznesowy. Odłącz jej definicję biznesową"
" przed zmianą obliczenia."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this source. Detach its business definition before"
" changing the source or scope."
msgstr ""
"To źródło jest używane przez pulpit biznesowy. Odłącz definicję biznesową "
"przed zmianą źródła lub zakresu."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"Poświadczenie jest zapisane. Jego wartość nigdy nie jest zwracana do tego "
"okna. Wprowadzenie nowego sekretu zastępuje poświadczenie tego połączenia."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "Edytor pulpitu może utworzyć kartę wyników."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "Nie można zmienić typu źródła danych."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr "Cel dla tego KPI. Cel 100 z wartością 72 pokazuje na pasku 72% celu."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"Grupa i wszystkie jej elementy podrzędne muszą mieć ten sam okres "
"obowiązywania."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Zapytania z przewodnikiem można używać tylko na pulpicie, do którego należy."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "Zapytanie z przewodnikiem musi należeć do pulpitu."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr ""
"Zapytanie z przewodnikiem wymaga źródła porównania należącego do tego "
"pulpitu."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "Filtr listy wymaga od 1 do 100 wartości."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr "Element nadrzędny musi być grupą ważoną na tym samym pulpicie."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposal may contain at most eight widgets."
msgstr "Propozycja może zawierać najwyżej osiem widżetów."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric could not be calculated. No widgets were changed."
msgstr ""
"Nie udało się obliczyć proponowanej metryki. Żadne widżety nie zostały "
"zmienione."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric is unavailable with your current access rights."
msgstr "Proponowana metryka nie jest dostępna przy obecnych uprawnieniach."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A record count must not specify a value field."
msgstr "Przy zliczaniu rekordów nie należy wskazywać pola wartości."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s showing %s."
msgstr "Lista rekordów %s z kolumnami %s."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s. Choose columns to display."
msgstr "Lista rekordów %s. Wybierz kolumny do wyświetlenia."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A saved guided query cannot be moved to another dashboard or provider."
msgstr ""
"Zapisanego zapytania z przewodnikiem nie można przenieść na inny pulpit ani "
"do innego dostawcy."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr ""
"Nie udało się odtworzyć miernika karty wyników. Odtwórz jego widżet przed "
"importem karty wyników."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr "Węzła karty wyników nie można przenieść do innego pulpitu."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "Karta wyników obsługuje maksymalnie 60 węzłów."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "Karta wyników obsługuje najwyżej pięć poziomów."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard tree cannot contain a cycle."
msgstr "Drzewo karty wyników nie może zawierać cyklu."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A short note explaining what this widget measures. Appears as an info "
"tooltip on the card."
msgstr ""
"Krótka notatka wyjaśniająca, co mierzy ten widżet. Pojawia się jako "
"podpowiedź informacyjna na karcie."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__sql_query
msgid ""
"A single read-only SELECT. First column is the category label; the remaining"
" numeric columns become measures. Dashboard Administrator only: other users "
"never receive query text."
msgstr ""
"Jedno zapytanie SELECT tylko do odczytu. Pierwsza kolumna zawiera etykietę "
"kategorii; pozostałe kolumny liczbowe stają się miarami. Tylko administrator"
" pulpitu: inni użytkownicy nigdy nie otrzymują treści zapytania."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__domain
msgid ""
"A static filter applied before any runtime dashboard filter. A plain domain "
"literal - never an evaluated expression."
msgstr ""
"Filtr statyczny stosowany przed jakimkolwiek filtrem pulpitu w czasie "
"wykonywania. Zwykły literał domeny - nigdy wyrażenie podlegające ewaluacji."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__domain
msgid "A static filter for this item, on top of the data source filter."
msgstr "Filtr statyczny dla tego elementu, oprócz filtra źródła danych."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A text block. Whatever you type renders as-is on the board."
msgstr "Blok tekstu. Wpisana treść jest wyświetlana na pulpicie bez zmian."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A transient/abstract model cannot be joined."
msgstr "Nie można połączyć modelu tymczasowego ani abstrakcyjnego."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__credential_id
