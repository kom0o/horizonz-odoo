#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A saved guided query cannot be moved to another dashboard or provider."
msgstr ""
"Une requête guidée enregistrée ne peut pas être déplacée vers un autre "
"tableau de bord ou fournisseur."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_portable.py:0
msgid ""
"A scorecard metric could not be restored. Restore its widget before "
"importing the scorecard."
msgstr ""
"Une mesure du tableau d’évaluation n’a pas pu être restaurée. Restaurez son "
"widget avant d’importer le tableau d’évaluation."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard node cannot move to another dashboard."
msgstr ""
"Un nœud du tableau d’évaluation ne peut pas être déplacé vers un autre "
"tableau de bord."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most 60 nodes."
msgstr "Un tableau d’évaluation prend en charge au maximum 60 nœuds."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard supports at most five levels."
msgstr "Un tableau d’évaluation accepte au maximum cinq niveaux."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A scorecard tree cannot contain a cycle."
msgstr ""
"L’arborescence d’un tableau d’évaluation ne peut pas contenir de cycle."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A short note explaining what this widget measures. Appears as an info "
"tooltip on the card."
msgstr ""
"Une brève note expliquant ce que mesure ce widget. S'affiche sous forme "
"d'infobulle sur la carte."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__sql_query
msgid ""
"A single read-only SELECT. First column is the category label; the remaining"
" numeric columns become measures. Dashboard Administrator only: other users "
"never receive query text."
msgstr ""
"Une seule instruction SELECT en lecture seule. La première colonne contient "
"le libellé de catégorie ; les autres colonnes numériques deviennent des "
"mesures. Réservé à l'administrateur des tableaux de bord : les autres "
"utilisateurs ne reçoivent jamais le texte de la requête."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_datasource__domain
msgid ""
"A static filter applied before any runtime dashboard filter. A plain domain "
"literal - never an evaluated expression."
msgstr ""
"Un filtre statique appliqué avant tout filtre de tableau de bord à "
"l'exécution. Un littéral de domaine simple - jamais une expression évaluée."

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__domain
