#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 within the target range; linear progress from 0 at each outer baseline "
"to 100 at the nearest target bound, capped between 0 and 100."
msgstr ""
"100 dans la plage cible ; progression linéaire de 0 à chaque référence "
"extérieure à 100 à la borne cible la plus proche, limitée entre 0 et 100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (actual − baseline) / (target − baseline), capped between 0 and 100."
msgstr ""
"100 × (valeur réelle − référence) / (cible − référence), limité entre 0 et "
"100."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid ""
"100 × (baseline − actual) / (baseline − target), capped between 0 and 100."
msgstr ""
"100 × (valeur initiale − valeur réelle) / (valeur initiale − cible), borné "
"entre 0 et 100."

