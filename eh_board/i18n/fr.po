#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid "A blank canvas"
msgstr "Une toile vierge"

#. module: eh_board
#: model:ir.model.fields,help:eh_board.field_eh_board_item__default_date_filter
msgid ""
"A built-in date range applied to this widget when the board's own date "
"filter is off."
msgstr ""
"Une plage de dates intégrée appliquée à ce widget lorsque le filtre de date "
"du tableau est désactivé."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this measure. Detach its business definition "
"before changing the calculation."
msgstr ""
"Un tableau de bord métier utilise cette mesure. Dissociez sa définition "
"métier avant de modifier le calcul."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_business.py:0
msgid ""
"A business dashboard uses this source. Detach its business definition before"
" changing the source or scope."
msgstr ""
"Un tableau de bord métier utilise cette source. Dissociez sa définition "
"métier avant de modifier la source ou le périmètre."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/remote_source_dialog.xml:0
msgid ""
"A credential is stored. Its value is never returned to this dialog. Entering"
" a new secret replaces this connection's credential."
msgstr ""
"Des identifiants sont enregistrés. Leur valeur n'est jamais renvoyée à cette"
" boîte de dialogue. La saisie d'un nouveau secret remplace les identifiants "
"de cette connexion."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/scorecard_dialog.xml:0
msgid "A dashboard editor can create the scorecard."
msgstr "Un éditeur du tableau de bord peut créer le tableau d’évaluation."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_dashboard.py:0
msgid "A data source type cannot be changed."
msgstr "Le type d'une source de données ne peut pas être modifié."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/board.xml:0
msgid ""
"A goal for this KPI. Target 100 with a value of 72 shows 72% of target on "
"the bar."
msgstr ""
"Un objectif pour ce KPI. Une cible de 100 avec une valeur de 72 affiche 72% "
"de la cible sur la barre."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A group and all its children must use the same effective period."
msgstr ""
"Un groupe et tous ses éléments enfants doivent utiliser la même période de "
"validité."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query can only be used on its owning dashboard."
msgstr ""
"Une requête guidée ne peut être utilisée que sur le tableau de bord auquel "
"elle appartient."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query must belong to a dashboard."
msgstr "Une requête guidée doit appartenir à un tableau de bord."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A guided query requires a board-owned comparison source."
msgstr ""
"Une requête guidée nécessite une source de comparaison appartenant au "
"tableau de bord."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A list filter requires 1 to 100 values."
msgstr "Un filtre de liste nécessite entre 1 et 100 valeurs."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_scorecard.py:0
msgid "A parent must be a weighted group in the same dashboard."
msgstr "Le parent doit être un groupe pondéré du même tableau de bord."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposal may contain at most eight widgets."
msgstr "Une proposition peut contenir au maximum huit widgets."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric could not be calculated. No widgets were changed."
msgstr ""
"Un indicateur proposé n'a pas pu être calculé. Aucun widget n'a été modifié."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_authoring.py:0
msgid "A proposed metric is unavailable with your current access rights."
msgstr ""
"Un indicateur proposé n'est pas disponible avec vos droits d'accès actuels."

#. module: eh_board
#. odoo-python
#: code:addons/eh_board/models/eh_board_query.py:0
msgid "A record count must not specify a value field."
msgstr ""
"Un comptage d’enregistrements ne doit pas préciser de champ de valeur."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
msgid "A record list of %s showing %s."
msgstr "Liste d'enregistrements de %s affichant %s."

#. module: eh_board
#. odoo-javascript
#: code:addons/eh_board/static/src/add_item_dialog.js:0
