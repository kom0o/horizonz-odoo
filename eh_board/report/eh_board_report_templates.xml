<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server-rendered PDF of a dashboard: KPI numbers, data tables and
         content, produced from the same grouped reads the board renders. A
         login-less, shareable/emailable document (no OWL, pure HTML). -->
    <template id="report_eh_board_dashboard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-esc="doc.name"/>
                        <p style="color:#888;font-size:11px;">Generated by Dashboard Builder</p>
                        <p style="color:#666;font-size:10px;" t-esc="doc._analysis_scope()['label']"/>
                        <t t-foreach="doc._report_data()" t-as="b">
                            <div style="margin:0 0 18px 0;page-break-inside:avoid;">
                                <h4 style="margin:0 0 6px 0;" t-esc="b['title']"/>
                                <p t-if="b.get('description')" style="font-size:10px;color:#666;" t-esc="b['description']"/>
                                <p t-if="b.get('warning')" style="font-size:11px;color:#925500;" t-esc="b['warning']"/>
                                <p t-if="b.get('last_success')" style="font-size:10px;">Last successful refresh: <t t-esc="b['last_success']"/> UTC</p>
                                <t t-if="b['kind'] == 'kpi'">
                                    <div style="font-size:30px;font-weight:700;" t-esc="b['value']"/>
                                    <div t-if="b.get('target')" style="color:#666;font-size:12px;">
                                        Target: <t t-esc="b['target']"/>
                                    </div>
                                </t>
                                <t t-elif="b['kind'] == 'content'">
                                    <div t-out="b['html']"/>
                                </t>
                                <t t-elif="b['kind'] == 'error'">
                                    <div style="color:#b00020;" t-esc="b['text']"/>
                                </t>
                                <t t-else="">
                                    <table class="table table-sm" style="width:100%;border-collapse:collapse;font-size:12px;">
                                        <thead>
                                            <tr style="border-bottom:2px solid #ccc;">
                                                <th t-foreach="b['columns']" t-as="c"
                                                    t-att-style="'text-align:left;padding:4px 8px;' if c_index == 0 else 'text-align:right;padding:4px 8px;'"
                                                    t-esc="c"/>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="b['rows']" t-as="row"
                                                style="border-bottom:1px solid #eee;">
                                                <td t-foreach="row" t-as="cell"
                                                    t-att-style="'text-align:left;padding:3px 8px;' if cell_index == 0 else 'text-align:right;padding:3px 8px;'"
                                                    t-esc="cell"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
