<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eh_board_dashboard_list" model="ir.ui.view">
        <field name="name">eh.board.dashboard.list</field>
        <field name="model">eh.board.dashboard</field>
        <field name="arch" type="xml">
            <list string="Dashboards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="item_count"/>
                <field name="parent_dashboard_id" optional="hide"/>
                <field name="owner_id"/>
                <field name="refresh_mode"/>
            </list>
        </field>
    </record>

    <record id="view_eh_board_dashboard_form" model="ir.ui.view">
        <field name="name">eh.board.dashboard.form</field>
        <field name="model">eh.board.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard">
                <header>
                    <button name="action_open_board" type="object" string="Open Board"
                            class="btn-primary" icon="fa-external-link"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dashboard name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="parent_dashboard_id"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   domain="[('id', '!=', id)]"/>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="shared_user_ids" widget="many2many_tags"
                                   placeholder="Share a draft with specific users"/>
                        </group>
                        <group>
                            <field name="refresh_mode"/>
                            <field name="refresh_interval"
                                   invisible="refresh_mode != 'interval'"/>
                            <field name="is_kiosk"/>
                            <field name="is_template"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this dashboard is for..."/>
                    <notebook>
                        <page string="Items" name="items">
                            <field name="item_ids" context="{'default_dashboard_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="item_type"/>
                                    <field name="datasource_id"/>
                                    <field name="primary_dimension_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Filters" name="filters">
                            <field name="filter_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="filter_type"/>
                                    <field name="field_id"/>
                                    <field name="date_preset"/>
                                    <field name="item_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Layouts" name="layouts">
                            <field name="layout_version_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="is_active"/>
                                    <field name="is_default"/>
                                    <field name="company_id"/>
                                    <field name="density"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eh_board_dashboard_kanban" model="ir.ui.view">
        <field name="name">eh.board.dashboard.kanban</field>
        <field name="model">eh.board.dashboard</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="item_count"/>
                <field name="state"/>
                <field name="thumbnail"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div t-if="record.thumbnail.raw_value" class="o_kanban_image">
                                <img t-att-src="kanban_image('eh.board.dashboard', 'thumbnail', record.id.raw_value)"
                                     t-att-alt="record.name.value"/>
                            </div>
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <span><field name="item_count"/> items</span>
                                <span class="badge rounded-pill float-end">
                                    <field name="state"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <button name="action_open_board" type="object"
                                        class="btn btn-sm btn-primary">Open Board</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eh_board_dashboard_search" model="ir.ui.view">
        <field name="name">eh.board.dashboard.search</field>
        <field name="model">eh.board.dashboard</field>
        <field name="arch" type="xml">
            <search string="Dashboards">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="parent_dashboard_id"/>
                <filter name="published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <filter name="top_level" string="Top-level"
                        domain="[('parent_dashboard_id', '=', False)]"/>
                <filter name="my" string="My Dashboards"
                        domain="[('owner_id', '=', uid)]"/>
                <filter name="templates" string="Templates"
                        domain="[('is_template', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_eh_board_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">eh.board.dashboard</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_eh_board_dashboard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first dashboard</p>
            <p>Build a live BI workspace: drag tiles onto a snapping grid, group any
               model's data database side, and drill anywhere.</p>
        </field>
    </record>

</odoo>
