<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_eh_board_credential_list" model="ir.ui.view">
        <field name="name">eh.board.credential.list</field>
        <field name="model">eh.board.credential</field>
        <field name="arch" type="xml">
            <list string="Credentials">
                <field name="name"/>
                <field name="kind"/>
                <field name="username"/>
            </list>
        </field>
    </record>

    <record id="view_eh_board_credential_form" model="ir.ui.view">
        <field name="name">eh.board.credential.form</field>
        <field name="model">eh.board.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kind"/>
                        <field name="username"/>
                        <field name="secret" password="True"
                               groups="eh_board.group_board_admin"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eh_board_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">eh.board.credential</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_eh_board_credentials"
              name="Credentials"
              parent="menu_eh_board_config"
              action="action_eh_board_credential"
              groups="eh_board.group_board_admin"
              sequence="30"/>

</odoo>
