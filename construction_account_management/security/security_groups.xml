<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction_billing" model="ir.module.category">
        <field name="name">Construction Financial Management</field>
        <field name="description">Manage construction clients, billings, retention, and payments.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_construction_billing_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_construction_billing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_construction_billing_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_construction_billing"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_billing_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
